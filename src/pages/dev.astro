---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout className="disallow-select" title="Dev Tools | Divulgando Ciencia">
    <div id="dev-content" class="hidden container py-8 max-w-6xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8 pb-6 border-b border-input gap-4">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-primary/10 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8"/><path d="M3 16.2V21m0 0h4.8M3 21v-4.8"/><path d="M21 7.8V3m0 0h-4.8M21 3v4.8"/><path d="M3 7.8V3m0 0h4.8M3 3v4.8"/><path d="M15 9H9v6h6V9z"/></svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold font-mono tracking-tighter flex items-center gap-2">
                        DIVULGANDO CIENCIA <span class="text-primary">DEV_PANEL</span>
                    </h1>
                    <p class="text-[10px] font-mono opacity-50 uppercase tracking-[0.2em]">Build: <span class="build-number"></span></p>
                </div>
            </div>
            <button id="disable-dev" class="px-4 py-2 bg-destructive/10 text-foreground border border-destructive/20 rounded font-mono text-[10px] hover:bg-destructive hover:text-white transition-all uppercase">
                Disable Dev Mode
            </button>
        </div>

        <div class="flex overflow-x-auto gap-2 mb-8 no-scrollbar border-b border-input pb-px">
            {["general", "network", "storage", "system", "danger_zone"].map((tab, i) => (
                <button 
                    data-tab={tab} 
                    class={`tab-btn px-6 py-3 font-mono text-[11px] uppercase tracking-wider transition-all border-b-2 ${i === 0 ? 'border-primary text-primary bg-primary/5 active' : 'border-transparent opacity-50 hover:opacity-100 hover:bg-muted'}`}
                >
                    {tab.replace('_', ' ')}
                </button>
            ))}
        </div>

        <div id="tab-container" class="min-h-[500px]">

            <div id="tab-general" class="tab-pane grid grid-cols-1 md:grid-cols-2 gap-6 font-mono text-[11px]">
                
                <div class="bg-card border rounded-xl p-6 md:col-span-2 border-primary/20">
                    <div class="flex items-center justify-between mb-8">
                        <h3 class="text-sm font-bold text-primary uppercase tracking-tighter flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/><circle cx="12" cy="12" r="4"/></svg>
                            Experimental_Feature_Flags
                        </h3>
                        <div class="text-[9px] opacity-40 uppercase tracking-widest">Storage: experimentalFeatures</div>
                    </div>
                    
                    <div id="flags-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <label class="flag-toggle flex items-center justify-between p-4 bg-muted/20 rounded-xl border border-input cursor-pointer hover:border-primary transition-all">
                            <div class="flex flex-col gap-1 pr-4">
                                <span class="font-bold">AI_SUMMARIES</span>
                                <span class="text-[9px] opacity-50 text-blue-400">Resúmenes automáticos con Gemini Nano (IA Local).</span>
                            </div>
                            <input type="checkbox" data-flag="ai_summaries" class="flag-checkbox sr-only peer">
                            <div class="w-10 h-5 bg-muted rounded-full peer peer-disabled:bg-destructive/40 peer-checked:bg-primary relative transition-colors after:content-[''] after:absolute after:top-1 after:left-1 after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:after:translate-x-5 shadow-inner"></div>
                        </label>
                        <label class="flag-toggle flex items-center justify-between p-4 bg-muted/20 rounded-xl border border-input cursor-pointer hover:border-primary transition-all">
                            <div class="flex flex-col gap-1 pr-4">
                                <span class="font-bold">A_CIENCIA_CIERTA_PLUS</span>
                                <span class="text-[9px] opacity-50 text-blue-400">Nuevas opciones para el Pasapalabra.</span>
                            </div>
                            <input type="checkbox" data-flag="pasapalabra_plus" class="flag-checkbox sr-only peer">
                            <div class="w-10 h-5 bg-muted rounded-full peer peer-disabled:bg-destructive/40 peer-checked:bg-primary relative transition-colors after:content-[''] after:absolute after:top-1 after:left-1 after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:after:translate-x-5 shadow-inner"></div>
                        </label>
                    </div>
                </div>

                <div class="bg-card border rounded-xl p-6 md:col-span-2">
                    <h3 class="text-sm font-bold mb-6 text-primary uppercase tracking-tighter">Diagnostics</h3>
                    <div class="flex flex-wrap gap-2">
                        <button id="perf-overlay" class="w-full py-3 bg-muted rounded border text-[10px] hover:border-primary transition-colors uppercase font-bold">Toggle_Performance_HUD</button>
                        <button id="test-notification" class="w-full py-3 bg-muted rounded border text-[10px] hover:border-primary transition-colors uppercase font-bold">Test_Notification</button>
                    </div>
                </div>
            </div>

            <div id="tab-network" class="tab-pane hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-card border rounded-xl p-6">
                        <h3 class="text-sm font-bold font-mono mb-4 text-blue-500 uppercase">Service_Worker_Controller</h3>
                        <div id="sw-details" class="space-y-3 font-mono text-xs"></div>
                    </div>
                    <div class="bg-card border rounded-xl p-6">
                        <h3 class="text-sm font-bold font-mono mb-4 text-primary uppercase">Cache_Storage_Manifest</h3>
                        <div id="cache-details" class="space-y-2 font-mono text-[10px]"></div>
                    </div>
                </div>
            </div>

            <div id="tab-storage" class="tab-pane hidden space-y-6">
                <div class="bg-card border rounded-xl p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-sm font-bold font-mono uppercase">Local_Storage_Editor</h3>
                        <button id="reload-local" class="text-[10px] text-foreground hover:underline font-mono">RELOAD</button>
                    </div>
                    <div id="local-storage-table" class="space-y-2 max-h-[400px] overflow-y-auto custom-scrollbar pr-2 text-wrap break-all"></div>
                </div>
            </div>

            <div id="tab-system" class="tab-pane hidden grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-card border rounded-xl p-6 space-y-4">
                    <h3 class="text-xs font-bold font-mono opacity-50 uppercase">Hardware_Specs</h3>
                    <div id="hardware-info" class="space-y-2 font-mono text-xs text-primary"></div>
                </div>
                <div class="bg-card border rounded-xl p-6 space-y-4">
                    <h3 class="text-xs font-bold font-mono opacity-50 uppercase">Viewport_Metrics</h3>
                    <div id="viewport-info" class="space-y-2 font-mono text-xs"></div>
                </div>
                <div class="bg-card border rounded-xl p-6 space-y-4">
                    <h3 class="text-xs font-bold font-mono opacity-50 uppercase">Browser_Core</h3>
                    <div id="browser-info" class="space-y-2 font-mono text-xs"></div>
                </div>
            </div>

            <div id="tab-kernel" class="tab-pane hidden">
                <div class="bg-destructive/5 border border-destructive/20 rounded-xl p-8 text-center space-y-6">
                    <div class="inline-block p-4 bg-destructive/10 rounded-full mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-destructive"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    </div>
                    <h2 class="text-2xl font-bold font-mono text-destructive uppercase tracking-widest">Danger_Zone_Override</h2>
                    <p class="text-sm font-mono opacity-60 max-w-lg mx-auto">Estas acciones son de bajo nivel y pueden causar inestabilidad en el entorno local. Úsalas bajo tu propia responsabilidad.</p>
                    <div class="flex flex-wrap justify-center gap-4">
                        <button id="wipe-all" class="px-8 py-4 bg-destructive text-white rounded font-bold font-mono text-xs uppercase shadow-xl shadow-destructive/20 hover:scale-105 active:scale-95 transition-all">Execute_Total_Purge</button>
                        <button id="hard-reload" class="px-8 py-4 bg-foreground text-background rounded font-bold font-mono text-xs uppercase hover:opacity-90 transition-all">Force_Kernel_Restart</button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div id="auth-shield" class="fixed inset-0 bg-background flex flex-col items-center justify-center z-2000">
        <div class="w-1 px-12 bg-primary animate-[height_2s_ease-in-out_infinite] mb-4"></div>
        <p class="font-mono text-[10px] tracking-[0.5em] uppercase opacity-50">Authenticating_Credentials...</p>
    </div>

    <style is:global>
        @keyframes height { 0%, 100% { height: 0px; } 50% { height: 40px; } }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .tab-btn.active { border-color: hsl(var(--primary)); color: hsl(var(--primary)); background: hsl(var(--primary) / 0.05); opacity: 1; }
    </style>

    <script>
        const initDevConsole = () => {
            const isDev = localStorage.getItem('devMode') === 'true';
            if (!isDev) { window.location.href = '/'; return; }
            const devVersion = localStorage.getItem('devVersion') || '0.0.0-stable';
            document.querySelectorAll('.build-number').forEach(element => element.textContent = devVersion);

            document.getElementById('dev-content')?.classList.remove('hidden');
            document.getElementById('auth-shield')?.classList.add('hidden');

            const tabs = document.querySelectorAll('.tab-btn');
            const panes = document.querySelectorAll('.tab-pane');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const target = tab.getAttribute('data-tab');
                    tabs.forEach(t => t.classList.remove('active', 'border-primary', 'text-primary', 'bg-primary/5'));
                    tab.classList.add('active', 'border-primary', 'text-primary', 'bg-primary/5');
                    
                    panes.forEach(p => p.classList.add('hidden'));
                    document.getElementById(`tab-${target}`)?.classList.remove('hidden');
                });
            });

            const updateNetwork = async () => {
                const swEl = document.getElementById('sw-details');
                const cacheEl = document.getElementById('cache-details');
                
                if ('serviceWorker' in navigator && swEl) {
                    const reg = await navigator.serviceWorker.getRegistration();
                    swEl.innerHTML = `
                        <div class="flex justify-between p-2 bg-muted/30 rounded border border-input"><span>Registration:</span> <span class="text-green-500 font-bold">ACTIVE</span></div>
                        <div class="flex justify-between p-2 bg-muted/30 rounded border border-input"><span>Active SW:</span> <span class="text-blue-500 truncate ml-4">${reg?.active ? 'YES' : 'NO'}</span></div>
                        <div class="flex flex-col p-2 bg-muted/30 rounded border border-input gap-1">
                            <span class="opacity-40 uppercase text-[9px]">Scope:</span> 
                            <span class="opacity-70 text-[10px] break-all">${reg?.scope || 'N/A'}</span>
                        </div>
                    `;
                }

                if (cacheEl) {
                    const keys = await caches.keys();
                    cacheEl.innerHTML = keys.length > 0 
                        ? keys.map(k => `<div class="p-2 bg-muted/20 rounded border border-input flex justify-between items-center gap-4"><span>${k}</span> <button class="text-[9px] bg-destructive/10 text-foreground px-2 py-1 rounded hover:bg-destructive hover:text-white transition-colors delete-cache" data-key="${k}">PURGE</button></div>`).join('')
                        : '<div class="opacity-30 text-center py-4">NO_CACHES_FOUND</div>';
                    
                    document.querySelectorAll('.delete-cache').forEach(b => b.addEventListener('click', async () => {
                        await caches.delete(b.getAttribute('data-key')!);
                        updateNetwork();
                    }));
                }
            };

            const updateStorage = () => {
                const table = document.getElementById('local-storage-table');
                if (!table) return;
                table.innerHTML = Object.keys(localStorage).map(k => `
                    <div class="grid grid-cols-4 gap-4 p-3 bg-muted/20 rounded border border-input text-[10px] items-center">
                        <span class="text-primary font-bold uppercase truncate">${k}</span>
                        <span class="truncate opacity-70 col-span-2">${localStorage.getItem(k)}</span>
                    </div>
                `).join('') || '<div class="opacity-30 text-center py-4 font-mono">EMPTY_VAULT</div>';
            };

            const updateSystem = () => {
                const hw = document.getElementById('hardware-info');
                const vp = document.getElementById('viewport-info');
                const br = document.getElementById('browser-info');

                if (hw) hw.innerHTML = `
                    <div class="flex justify-between"><span>Memory:</span> <span>${(navigator as any).deviceMemory || 'N/A'} GB</span></div>
                    <div class="flex justify-between"><span>Cores:</span> <span>${navigator.hardwareConcurrency || 'N/A'}</span></div>
                    <div class="flex justify-between"><span>Connection:</span> <span class="uppercase">${(navigator as any).connection?.effectiveType || 'N/A'}</span></div>
                `;
                if (vp) vp.innerHTML = `
                    <div class="flex justify-between"><span>Screen:</span> <span>${window.screen.width}x${window.screen.height}</span></div>
                    <div class="flex justify-between"><span>Window:</span> <span>${window.innerWidth}x${window.innerHeight}</span></div>
                    <div class="flex justify-between"><span>DPR:</span> <span>${window.devicePixelRatio}</span></div>
                `;
                if (br) br.innerHTML = `
                    <div class="flex justify-between"><span>Cookies:</span> <span>${navigator.cookieEnabled ? 'ON' : 'OFF'}</span></div>
                    <div class="flex justify-between"><span>Locale:</span> <span>${navigator.language.toUpperCase()}</span></div>
                    <div class="flex justify-between"><span>Platform:</span> <span class="uppercase">${navigator.platform}</span></div>
                `;
            };

            document.getElementById('test-notification')?.addEventListener('click', () => alert('DEV_SYSTEM: Manual trigger alert test success.'));
            let perfInterval: any;
            document.getElementById('perf-overlay')?.addEventListener('click', () => {
                let hud = document.getElementById('perf-hud');
                if (hud) {
                    hud.remove();
                    if (perfInterval) clearInterval(perfInterval);
                } else {
                    hud = document.createElement('div');
                    hud.id = 'perf-hud';
                    hud.style.cssText = 'position:fixed;top:10px;right:10px;background:rgba(0,0,0,0.85);color:#00ff00;padding:8px 12px;font-family:monospace;font-size:10px;z-index:9999;border:1px solid #00ff00;pointer-events:none;border-radius:4px;box-shadow:0 0 10px rgba(0,255,0,0.2);line-height:1;';
                    document.body.appendChild(hud);

                    let lastTime = performance.now();
                    let frames = 0;
                    let fps = 0;

                    perfInterval = setInterval(() => {
                        const now = performance.now();
                        frames++;
                        if (now > lastTime + 1000) {
                            fps = Math.round((frames * 1000) / (now - lastTime));
                            frames = 0;
                            lastTime = now;
                        }
                        
                        // @ts-ignore
                        const mem = (performance as any).memory ? Math.round((performance as any).memory.usedJSHeapSize / 1024 / 1024) + 'MB' : 'N/A';
                        hud!.innerHTML = `<div style="display:flex;gap:15px"><span>FPS: ${fps}</span><span>MEM: ${mem}</span></div>`;
                    }, 100);
                }
            });

            const initFeatureFlags = () => {
                const savedFlags = JSON.parse(localStorage.getItem('experimentalFeatures') || '{}');
                const checkboxes = document.querySelectorAll('.flag-checkbox');
                
                checkboxes.forEach(cb => {
                    const flagName = cb.getAttribute('data-flag');
                    if (flagName) {
                        (cb as HTMLInputElement).checked = !!savedFlags[flagName];

                        if (['ai_summaries'].includes(flagName)) (cb as HTMLInputElement).disabled = !('Summarizer' in window);

                        cb.addEventListener('change', () => {
                            const currentFlags = JSON.parse(localStorage.getItem('experimentalFeatures') || '{}');
                            currentFlags[flagName] = (cb as HTMLInputElement).checked;
                            localStorage.setItem('experimentalFeatures', JSON.stringify(currentFlags));
                            console.log(`🛠️ [DEV_SYSTEM] Flag '${flagName}' updated:`, currentFlags[flagName]);
                        });
                    }
                });
                const currentFlags = JSON.parse(localStorage.getItem('experimentalFeatures') || '{}');
                const updatedFlags = {};
                ['ai_summaries', 'pasapalabra_plus'].forEach((flagName: any) => updatedFlags[flagName] = currentFlags[flagName] || false);
                localStorage.setItem('experimentalFeatures', JSON.stringify(updatedFlags));
            };

            document.getElementById('disable-dev')?.addEventListener('click', () => {
                localStorage.removeItem('devMode');
                localStorage.removeItem('experimentalFeatures');
                window.location.href = '/';
            });
            document.getElementById('wipe-all')?.addEventListener('click', () => {
                if (confirm('CRITICAL_WARNING: This will erase ALL local data. Proceed?')) {
                    localStorage.clear();
                    sessionStorage.clear();
                    window.location.href = '/';
                }
            });
            document.getElementById('hard-reload')?.addEventListener('click', () => window.location.reload());
            document.getElementById('reload-local')?.addEventListener('click', () => { updateStorage(); });

            updateNetwork();
            updateStorage();
            updateSystem();
            initFeatureFlags();
        };

        document.addEventListener('page-load', () => {initDevConsole();});
    </script>
</BaseLayout>
