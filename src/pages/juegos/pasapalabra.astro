---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { frontmatter } from "@/json/frontmatter";

const lang = Astro.locals.lang || 'es';
const cf = frontmatter[lang]['juegos/pasapalabra'];
---
<BaseLayout cf={cf} className="disallow-select">
    <div class="container px-4 py-8 md:py-12 relative z-10 flex flex-col items-center justify-center min-h-[80vh]">
        <div id="game-container" class="w-full max-w-4xl bg-white/10 dark:bg-black/20 backdrop-blur-xl border border-white/20 dark:border-white/10 rounded-3xl p-8 shadow-2xl overflow-hidden relative">
            
            <div id="start-screen" class="flex flex-col items-center justify-center text-center space-y-6 py-12">
                <div class="w-24 h-24 bg-primary/20 rounded-full flex items-center justify-center animate-bounce">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-blue-400">Pasapalabra Científico</h1>
                <p class="text-lg text-muted-foreground max-w-md">
                    Demuestra tus conocimientos de ciencia en este reto de la A a la Z.
                </p>
                <button id="start-btn" class="px-8 py-4 bg-primary hover:bg-primary/90 text-white rounded-full font-bold text-xl transition-all hover:scale-105 active:scale-95 shadow-lg shadow-primary/20">
                    Empezar Juego
                </button>

                <div id="game-options" class="hidden mt-8 p-6 bg-white/5 border border-white/10 rounded-3xl w-full max-w-sm text-left animate-in fade-in">
                    <h3 class="text-lg font-bold mb-4 opacity-70 flex items-center gap-2 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                        </svg>
                        Opciones de partida
                    </h3>
                    <div class="space-y-4">
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input type="checkbox" id="no-time-opt" class="w-5 h-5 accent-primary rounded-md" />
                            <span class="text-sm font-medium group-hover:text-primary transition-colors">Quitar límite de tiempo</span>
                        </label>
                        
                        <div class="space-y-2">
                            <span class="text-[10px] uppercase tracking-wider opacity-50 font-black">Filtrar preguntas</span>
                            <select id="difficulty-opt" class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-sm outline-none focus:ring-2 focus:ring-primary transition-all">
                                <option value="normales">Solo normales</option>
                                <option value="extremas">Solo extremas</option>
                                <option value="todas">Todas</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div id="game-screen" class="hidden flex flex-col lg:flex-row items-center justify-around gap-12 py-4">
                
                <div class="relative w-[300px] h-[300px] md:w-[450px] md:h-[450px] flex items-center justify-center">
                    <div id="rosco" class="relative w-full h-full rounded-full border-0 flex items-center justify-center">
                    </div>
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <div class="text-center p-4 bg-white/5 dark:bg-black/40 rounded-full w-2/3 aspect-square flex flex-col items-center justify-center backdrop-blur-sm border border-white/10 shadow-inner">
                            <span id="timer" class="text-4xl font-mono font-bold text-primary">150</span>
                            <span class="text-xs uppercase tracking-widest opacity-50">Segundos</span>
                        </div>
                    </div>
                </div>

                <div class="flex-1 w-full max-w-md space-y-6">
                    <div class="flex justify-between items-center bg-white/5 dark:bg-black/20 p-4 rounded-2xl border border-white/10">
                        <div class="text-center">
                            <span class="block text-2xl font-bold text-success" id="correct-count">0</span>
                            <span class="text-xs uppercase opacity-50">Aciertos</span>
                        </div>
                        <div class="h-8 w-[1px] bg-white/10"></div>
                        <div class="text-center">
                            <span class="block text-2xl font-bold text-error" id="error-count">0</span>
                            <span class="text-xs uppercase opacity-50">Fallos</span>
                        </div>
                        <div class="h-8 w-[1px] bg-white/10"></div>
                        <div class="text-center">
                            <span class="block text-2xl font-bold text-primary" id="pending-count">27</span>
                            <span class="text-xs uppercase opacity-50">Quedan</span>
                        </div>
                    </div>

                    <div id="question-box" class="bg-white/5 dark:bg-black/30 p-6 rounded-3xl border border-white/10 shadow-xl min-h-[180px] flex flex-col justify-center">
                        <div id="letter-indicator" class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mb-4 shadow-lg shadow-primary/30">A</div>
                        <p id="question-type" class="text-sm font-medium text-primary mb-1 uppercase tracking-tighter">Empieza por...</p>
                        <p id="question-text" class="text-xl md:text-2xl font-medium leading-relaxed italic">Cargando pregunta...</p>
                    </div>

                    <div class="space-y-3">
                        <input type="text" id="answer-input" placeholder="Escribe tu respuesta..." class="w-full px-6 py-4 bg-white/10 dark:bg-black/40 border-2 border-white/10 focus:border-primary rounded-2xl text-xl outline-none transition-all placeholder:opacity-30" autocomplete="off" />
                        <div class="grid grid-cols-2 gap-3">
                            <button id="submit-btn" class="py-4 bg-primary text-white rounded-2xl font-bold text-lg hover:bg-primary/90 transition-all">Enviar</button>
                            <button id="pasapalabra-btn" class="py-4 bg-warn text-white rounded-2xl font-bold text-lg hover:bg-warn/90 transition-all">Pasapalabra</button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="result-screen" class="hidden flex flex-col items-center justify-center text-center space-y-8 py-12">
                <h2 class="text-3xl md:text-5xl font-bold">¡Juego Terminado!</h2>
                
                <div class="grid grid-cols-3 gap-4 w-full max-w-lg">
                    <div class="bg-success/20 p-6 rounded-3xl border border-success/30">
                        <span class="block text-4xl font-bold text-success" id="final-correct">0</span>
                        <span class="text-sm uppercase font-medium">Aciertos</span>
                    </div>
                    <div class="bg-error/20 p-6 rounded-3xl border border-error/30">
                        <span class="block text-4xl font-bold text-error" id="final-error">0</span>
                        <span class="text-sm uppercase font-medium">Fallos</span>
                    </div>
                    <div class="bg-primary/20 p-6 rounded-3xl border border-primary/30">
                        <span class="block text-4xl font-bold text-primary" id="final-time">0</span>
                        <span class="text-sm uppercase font-medium">Segs Restantes</span>
                    </div>
                </div>

                <div id="score-message" class="text-xl text-muted-foreground italic">
                    "¡Increíble conocimiento científico!"
                </div>

                <button id="restart-btn" class="px-8 py-4 border-2 border-primary text-primary hover:bg-primary hover:text-white rounded-full font-bold text-xl transition-all">
                    Jugar de nuevo
                </button>
            </div>

        </div>
    </div>

    <style is:global>
        #game-container {
            min-height: 500px;
        }

        .letter-node {
            position: absolute;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
            color: white;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: #3388ff; /* blue - pending */
            border: 2px solid rgba(255,255,255,0.2);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        @media (min-width: 768px) {
            .letter-node {
                width: 44px;
                height: 44px;
                font-size: 18px;
            }
        }

        .letter-node.active {
            transform: scale(1.3);
            background: #ee9950; /* orange - active */
            box-shadow: 0 0 20px rgba(238, 153, 80, 0.5);
            z-index: 10;
            border-color: white;
        }

        .letter-node.correct {
            background: #00d084; /* green */
            box-shadow: 0 0 15px rgba(0, 208, 132, 0.3);
        }

        .letter-node.error {
            background: #ff141e; /* red */
            box-shadow: 0 0 15px rgba(255, 20, 30, 0.3);
        }

        .shake {
            animation: shake 0.5s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
        }

        .pop {
            animation: pop 0.3s ease-out;
        }

        @keyframes pop {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
    </style>

    <script is:inline>
        const TOTAL_TIME = 200;
        const API_URL = '/api/juegos/pasapalabra';

        let questions = [];
        let currentIndex = 0;
        let correctCount = 0;
        let errorCount = 0;
        let timeLeft = TOTAL_TIME;
        let timerInterval = null;
        let gameActive = false;
        let config = {
            noTime: false,
            dificultad: 'todas'
        };

        const startScreen = document.getElementById('start-screen');
        const gameScreen = document.getElementById('game-screen');
        const resultScreen = document.getElementById('result-screen');
        const rosco = document.getElementById('rosco');
        const timerEl = document.getElementById('timer');
        const timerContainer = timerEl.parentElement;
        const correctEl = document.getElementById('correct-count');
        const errorEl = document.getElementById('error-count');
        const pendingEl = document.getElementById('pending-count');
        const letterIndicator = document.getElementById('letter-indicator');
        const questionType = document.getElementById('question-type');
        const questionText = document.getElementById('question-text');
        const answerInput = document.getElementById('answer-input');
        const submitBtn = document.getElementById('submit-btn');
        const pasapalabraBtn = document.getElementById('pasapalabra-btn');
        const restartBtn = document.getElementById('restart-btn');
        const startBtn = document.getElementById('start-btn');

        const noTimeOpt = document.getElementById('no-time-opt');
        const difficultyOpt = document.getElementById('difficulty-opt');
        const gameOptionsContainer = document.getElementById('game-options');

        const experimentalFlags = JSON.parse(localStorage.getItem('experimentalFeatures') || '{}');
        const experimentalFeature = experimentalFlags.pasapalabra_plus || false;
        if (experimentalFeature) gameOptionsContainer.classList.remove('hidden');

        function normalize(str) {
            return str
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .trim();
        }

        function initRosco(letters) {
            rosco.innerHTML = '';
            const rect = rosco.getBoundingClientRect();
            const width = rect.width || 450;
            const radius = width / 2;
            const angleStep = (2 * Math.PI) / letters.length;

            letters.forEach((item, i) => {
                const angle = i * angleStep - Math.PI / 2;
                const x = radius + (radius - 22) * Math.cos(angle);
                const y = radius + (radius - 22) * Math.sin(angle);

                const node = document.createElement('div');
                node.className = 'letter-node';
                node.id = `letter-${i}`;
                node.textContent = item.letra;
                node.style.position = 'absolute';
                node.style.left = `${x}px`;
                node.style.top = `${y}px`;
                node.style.transform = `translate(-50%, -50%)`;
                
                if (item.status === 'correct') node.classList.add('correct');
                if (item.status === 'error') node.classList.add('error');
                
                rosco.appendChild(node);
            });
        }

        async function loadGame() {
            try {
                startBtn.disabled = true;
                startBtn.textContent = "Cargando...";

                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dificultad: config.dificultad })
                });
                
                questions = await response.json();
                
                if (questions.error) throw new Error(questions.error);

                questions = questions.map(q => ({ ...q, status: 'pending' }));
                initRosco(questions);
                updateStats();
                
                startBtn.disabled = false;
                startBtn.textContent = "Empezar Juego";
            } catch (error) {
                console.error("Error loading questions:", error);
                alert("Error al cargar las preguntas: " + error.message);
                startBtn.disabled = false;
                startBtn.textContent = "Reintentar";
            }
        }

        async function startGame() {
            config.noTime = noTimeOpt.checked;
            config.dificultad = difficultyOpt.value;

            await loadGame();

            if (questions.length === 0) return;

            gameActive = true;
            currentIndex = 0;
            correctCount = 0;
            errorCount = 0;
            timeLeft = TOTAL_TIME;
            
            startScreen.classList.add('hidden');
            gameScreen.classList.remove('hidden');
            resultScreen.classList.add('hidden');
            
            initRosco(questions);
            
            loadQuestion();
            startTimer();
            
            setTimeout(() => answerInput.focus(), 100);
        }

        function startTimer() {
            clearInterval(timerInterval);
            
            if (config.noTime) {
                timerEl.textContent = "∞";
                timerContainer.querySelector('span:last-child').textContent = "Ilimitado";
                return;
            }

            timerContainer.querySelector('span:last-child').textContent = "Segundos";
            timerEl.textContent = timeLeft;

            timerInterval = setInterval(() => {
                timeLeft--;
                timerEl.textContent = timeLeft;
                if (timeLeft <= 0) {
                    endGame();
                }
            }, 1000);
        }

        function loadQuestion() {
            const startSearch = currentIndex;
            let found = false;

            for (let i = 0; i < questions.length; i++) {
                const checkIndex = (startSearch + i) % questions.length;
                if (questions[checkIndex].status === 'pending') {
                    currentIndex = checkIndex;
                    found = true;
                    break;
                }
            }

            if (!found) {
                endGame();
                return;
            }

            const q = questions[currentIndex];
            
            document.querySelectorAll('.letter-node').forEach(n => n.classList.remove('active'));
            document.getElementById(`letter-${currentIndex}`).classList.add('active');

            letterIndicator.textContent = q.letra;
            questionType.textContent = q.empieza_por ? 'Empieza por...' : 'Contiene la...';
            questionText.textContent = q.pregunta;
            answerInput.value = '';
            answerInput.focus();
        }

        function handleAnswer() {
            const answer = answerInput.value.trim();
            if (!answer) return;

            const q = questions[currentIndex];
            const normalizedAnswer = normalize(answer);
            const isCorrect = q.respuestas.some(r => normalize(r) === normalizedAnswer);

            const letterNode = document.getElementById(`letter-${currentIndex}`);
            letterNode.classList.remove('active');

            if (isCorrect) {
                q.status = 'correct';
                correctCount++;
                letterNode.classList.add('correct', 'pop');
                updateStats();
                setTimeout(loadQuestion, 400);
            } else {
                q.status = 'error';
                errorCount++;
                letterNode.classList.add('error', 'shake');
                
                const correctOnes = q.respuestas.join(' o ');
                questionType.textContent = '¡Incorrecto!';
                questionType.classList.add('text-error');
                questionType.classList.remove('text-primary');
                questionText.innerHTML = `La respuesta correcta era: <span class="text-error font-bold">${correctOnes}</span>`;
                
                answerInput.disabled = true;
                submitBtn.disabled = true;
                pasapalabraBtn.disabled = true;
                
                updateStats();

                setTimeout(() => {
                    questionType.classList.remove('text-error');
                    questionType.classList.add('text-primary');
                    answerInput.disabled = false;
                    submitBtn.disabled = false;
                    pasapalabraBtn.disabled = false;
                    loadQuestion();
                }, 2000);
            }
        }

        function handlePasapalabra() {
            const letterNode = document.getElementById(`letter-${currentIndex}`);
            letterNode.classList.remove('active');
            
            currentIndex = (currentIndex + 1) % questions.length;
            loadQuestion();
        }

        function updateStats() {
            correctEl.textContent = correctCount;
            errorEl.textContent = errorCount;
            const pending = questions.filter(q => q.status === 'pending').length;
            pendingEl.textContent = pending;
            initRosco(questions);
        }

        function endGame() {
            gameActive = false;
            clearInterval(timerInterval);
            
            gameScreen.classList.add('hidden');
            resultScreen.classList.remove('hidden');
            
            document.getElementById('final-correct').textContent = correctCount;
            document.getElementById('final-error').textContent = errorCount;
            document.getElementById('final-time').textContent = Math.max(0, timeLeft);
            
            const scoreMsg = document.getElementById('score-message');
            if (correctCount === questions.length) scoreMsg.textContent = "¡PERFECTO! ¡Eres un genio de la ciencia!";
            else if (correctCount > 20) scoreMsg.textContent = "¡Impresionante! Tienes un nivel científico altísimo.";
            else if (correctCount > 10) scoreMsg.textContent = "¡Buen trabajo! Pero aún puedes mejorar.";
            else scoreMsg.textContent = "¡Sigue estudiando! La ciencia es apasionante.";
        }

        startBtn.addEventListener('click', startGame);
        restartBtn.addEventListener('click', () => {
            questions.forEach(q => q.status = 'pending');
            initRosco(questions);
            startGame();
        });

        submitBtn.addEventListener('click', handleAnswer);
        pasapalabraBtn.addEventListener('click', handlePasapalabra);

        answerInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleAnswer();
        });

        window.addEventListener('load', loadGame);

        window.addEventListener('resize', () => {
            if (questions.length > 0) {
                initRosco(questions)
                document.querySelectorAll('.letter-node').forEach(n => n.classList.remove('active'));
                document.getElementById(`letter-${currentIndex}`).classList.add('active');
            };
        });
    </script>

</BaseLayout>