---
import { getCollection } from 'astro:content'
import { ScienceList } from '../Science';
import { calcReadTime } from '../readTime';
import SkeletonCard from '../ui/SkeletonCard.astro';
const { articles } = Astro.props;
import { clientTranslations } from '../../i18n';
const {lang} = Astro.props;
const t = clientTranslations[lang];
const authors = await getCollection('authors');
const trendingArticles = []
if (articles) {
    articles.sort((a, b) => b.date.getTime() - a.date.getTime()).map((data) => {
        trendingArticles.push({
            title: data.title,
            author: [authors.filter(({id}) => id == data.author.id)[0].data, data.author.id],
            description: data.description,
            dateName: data.date.toLocaleDateString(t.articles.timeStamp, { year: 'numeric', month: 'long', day: 'numeric' }),
            science: ScienceList.filter(({id}) => id == data.slug.split('/')[1])[0],
            readTime: calcReadTime(data.body),
            id: data.slug.split('/')[2],
            slug: data.slug,
        })
    })
}
---

<div class="w-full">
    <div class="tabs">
        <div class="flex items-center justify-between mb-4" id="articles-tabs-buttons">
            <div class="flex blue-border border rounded-lg overflow-hidden">
                <button class="px-4 py-2 bg-primary text-primary-foreground transition-colors" data-tab="recent">{t.home.articles.recent}</button>
                <button class="px-4 py-2 hover:bg-muted transition-colors" style="display: none;" id="cached-articles" data-tab="cached-articles-section">{t.home.articles.saved}</button>
                <button class="px-4 py-2 hover:bg-muted transition-colors" data-tab="trending">{t.home.articles.trending}</button>
            </div>
        </div>
        
        <div class="tab-content" id="recent">
            <div class="space-y-4" id="recent-articles-container">
                <SkeletonCard />
                <SkeletonCard />
                <SkeletonCard />
            </div>
        </div>
        
        <div class="tab-content hidden" id="cached-articles-section">
            <div class="space-y-4" id="saved-articles-container">
                <SkeletonCard />
                <SkeletonCard />
            </div>
        </div>
        
        <div class="tab-content hidden" id="trending">
            <div class="space-y-4" id="trending-articles-container">
                <SkeletonCard />
                <SkeletonCard />
                <SkeletonCard />
            </div>
        </div>
    </div>
</div>

<script>
    import { clientTranslations } from '../../i18n';
    document.addEventListener('astro:page-load', async () => {
        const lang = document.documentElement.lang || 'es';
        const t = clientTranslations[lang];
        const tabButtons = document.querySelectorAll('[data-tab]');
        const tabContents = document.querySelectorAll('.tab-content');
        
        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const tabId = button.getAttribute('data-tab');
                tabButtons.forEach(btn => {
                    if (btn.getAttribute('data-tab') === tabId) {
                        btn.classList.add('bg-primary', 'text-primary-foreground');
                        btn.classList.remove('hover:bg-muted');
                    } else {
                        btn.classList.remove('bg-primary', 'text-primary-foreground');
                        btn.classList.add('hover:bg-muted');
                    }
                });
                tabContents.forEach(content => {
                    content.classList.toggle('hidden', content.id !== tabId);
                });
            });
        });

        const recentContainer = document.getElementById('recent-articles-container');
        if (recentContainer) {
            try {
                const response = await fetch(`/api/content/${lang}/home`);
                const data = await response.json();
                recentContainer.innerHTML = data.recentArticles;
            } catch (e) {
                console.error("Error cargando recientes:", e);
            }
        }

        const trendingContainer = document.getElementById('trending-articles-container');
        if (trendingContainer) {
            try {
                const response = await fetch(`/api/database/gettrending`,{
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ lang })
                });
                const data = await response.json();
                trendingContainer.innerHTML = data.trendingArticles;
            } catch (e) {
                console.error("Error cargando trending:", e);
            }
        }
    });
</script>

