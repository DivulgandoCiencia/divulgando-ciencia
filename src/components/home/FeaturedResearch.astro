---
import Button from '../ui/Button.astro';
import SkeletonCard from '../ui/SkeletonCard.astro';
import { clientTranslations } from '../../i18n';
const {lang} = Astro.props;
const t = clientTranslations[lang];
---

<section class="container px-4 py-12 md:px-6 relative">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 relative z-10">
        <div>
            <h2 class="text-2xl font-bold tracking-tight">{t.home.featuredResearch.title}</h2>
            <p class="text-muted-foreground">{t.home.featuredResearch.subtitle}</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/articles">
                <Button variant="outline" size="sm" className="h-8">
                    {t.home.featuredResearch.viewAll}
                </Button>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 relative z-10" id="featured-articles-container">
        <SkeletonCard />
        <SkeletonCard />
        <SkeletonCard />
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', async () => {
        const container = document.getElementById('featured-articles-container');
        if (!container) return;

        const lang = document.documentElement.lang || 'es';
        
        try {
            const response = await fetch(`/api/content/${lang}/home`);
            const data = await response.json();
            container.innerHTML = data.featuredArticles;
        } catch (e) {
            console.error("Error cargando destacados:", e);
        }
    });
</script>

