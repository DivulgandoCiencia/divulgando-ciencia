---
// src/components/ui/SkeletonCard.astro
---
<div class="overflow-hidden rounded-lg shadow-md dark:shadow-[#151515] bg-card text-card-foreground h-full flex flex-col animate-pulse disallow-select">
    <div class="h-48 w-full bg-muted"></div>
    
    <div class="p-6 flex-1 flex flex-col space-y-4">
        <div class="flex items-center gap-2">
            <div class="h-4 w-20 bg-muted rounded-full"></div>
            <div class="h-3 w-24 bg-muted rounded"></div>
        </div>

        <div class="space-y-2">
            <div class="h-6 w-3/4 bg-muted rounded"></div>
        </div>
        <div class="space-y-2 flex-1">
            <div class="h-4 w-full bg-muted rounded"></div>
            <div class="h-4 w-full bg-muted rounded"></div>
            <div class="h-4 w-2/3 bg-muted rounded"></div>
        </div>
        
        <div class="flex justify-between items-center mt-auto pt-4">
            <div class="flex items-center gap-2">
                <div class="h-6 w-6 rounded-full bg-muted"></div>
                <div class="h-4 w-24 bg-muted rounded"></div>
            </div>
            <div class="h-8 w-24 bg-muted rounded-md"></div>
        </div>
    </div>
</div>
